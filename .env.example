SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:postgresql://localhost:5432/gygdatabase
DB_USER=postgres
DB_PASSWORD=replace-with-a-secret
APP_CORS_ALLOWED_ORIGINS=https://your-frontend.example
APP_CORS_DEV_ORIGINS=http://localhost:*,http://127.0.0.1:*
APP_REMOTE_IP_HEADER=X-Forwarded-For

APP_ADMIN_EMAILS=admin@example.com
APP_MAIL_FROM=your-address@gmail.com
APP_MAIL_TEST_CONNECTION=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-address@gmail.com
SMTP_PASSWORD=your-16-character-gmail-app-password-without-spaces
SMTP_AUTH=true
SMTP_STARTTLS_ENABLE=true
SMTP_STARTTLS_REQUIRED=true
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_TIMEOUT_MS=5000
SMTP_WRITE_TIMEOUT_MS=5000

APP_CAPTCHA_ENABLED=true
APP_CAPTCHA_PROVIDER=turnstile
APP_CAPTCHA_SECRET=
APP_CAPTCHA_EXPECTED_HOSTNAMES=app.example.com
APP_SWAGGER_PUBLIC=false
APP_TRUSTED_PROXIES=(?!)
APP_RATE_LIMIT_CONTACTO_PER_HOUR=5
APP_RATE_LIMIT_NEWSLETTER_PER_HOUR=5
APP_RATE_LIMIT_CHAT_PER_MINUTE=20
APP_RATE_LIMIT_SEGUIMIENTO_PER_MINUTE=10
APP_RATE_LIMIT_SEGUIMIENTO_ATTEMPTS_PER_15_MIN=20
APP_RATE_LIMIT_SEGUIMIENTO_FAILED_PER_15_MIN=5
APP_RATE_LIMIT_PASSWORD_RESET_PER_HOUR=5
APP_TRACKING_CODE_PEPPER=replace-with-at-least-32-random-bytes
APP_TRACKING_CODE_LEGACY_ENABLED=true
APP_PRIVACY_POLICY_VERSION=2026-01
APP_CHAT_LOG_RETENTION_MONTHS=12
APP_CHAT_LOG_RETENTION_CRON=0 0 3 * * *
APP_MAX_REQUEST_BODY_SIZE=1MB

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
