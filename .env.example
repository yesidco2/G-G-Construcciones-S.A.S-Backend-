SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:postgresql://localhost:5432/gygdatabase
DB_USER=postgres
DB_PASSWORD=replace-with-a-secret
APP_CORS_ALLOWED_ORIGINS=https://your-frontend.example
APP_CORS_DEV_ORIGINS=http://localhost:*,http://127.0.0.1:*

FIREBASE_ENABLED=true
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_PATH=/secure/path/firebase-service-account.json
FIREBASE_CREDENTIALS_JSON=
APP_ADMIN_EMAILS=admin@example.com

APP_SWAGGER_PUBLIC=false
APP_TRUSTED_PROXIES=(?!)
APP_RATE_LIMIT_CONTACTO_PER_HOUR=5
APP_RATE_LIMIT_CHAT_PER_MINUTE=20
APP_RATE_LIMIT_SEGUIMIENTO_PER_MINUTE=10
APP_UPLOADS_DIR=./var/uploads/obra-fotos
APP_TRACKING_CODE_PEPPER=replace-with-at-least-32-random-bytes
APP_PRIVACY_POLICY_VERSION=2026-01
APP_CHAT_LOG_RETENTION_MONTHS=12
APP_CHAT_LOG_RETENTION_CRON=0 0 3 * * *
NVD_API_KEY=
