spring.application.name=GYG_Backend

spring.datasource.url=${DB_URL}
spring.datasource.username=${DB_USER}
spring.datasource.password=${DB_PASSWORD}
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
app.cors.allowed-origins=${APP_CORS_ALLOWED_ORIGINS:http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000}
app.captcha.enabled=${APP_CAPTCHA_ENABLED:true}
app.captcha.provider=${APP_CAPTCHA_PROVIDER:turnstile}
app.captcha.secret=${APP_CAPTCHA_SECRET:}
app.captcha.ticket-ttl-seconds=${APP_CAPTCHA_TICKET_TTL_SECONDS:120}
app.firebase.enabled=${FIREBASE_ENABLED:true}
app.firebase.project-id=${FIREBASE_PROJECT_ID:}
app.firebase.credentials-path=${FIREBASE_CREDENTIALS_PATH:}
app.firebase.credentials-json=${FIREBASE_CREDENTIALS_JSON:}
app.auth.admin-emails=${APP_ADMIN_EMAILS:}
app.swagger.public=${APP_SWAGGER_PUBLIC:false}
app.security.trust-proxy-headers=${APP_TRUST_PROXY_HEADERS:false}
app.rate-limit.contacto-per-hour=${APP_RATE_LIMIT_CONTACTO_PER_HOUR:5}
app.rate-limit.chat-per-minute=${APP_RATE_LIMIT_CHAT_PER_MINUTE:20}
app.rate-limit.seguimiento-per-minute=${APP_RATE_LIMIT_SEGUIMIENTO_PER_MINUTE:10}
app.uploads.path=${APP_UPLOADS_DIR:./var/uploads/obra-fotos}
spring.profiles.default=prod
spring.jpa.hibernate.ddl-auto=validate
spring.flyway.enabled=true
spring.flyway.baseline-on-migrate=true
spring.flyway.baseline-version=1
app.cors.dev-origins=${APP_CORS_DEV_ORIGINS:http://localhost:*,http://127.0.0.1:*}
