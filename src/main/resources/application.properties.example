spring.application.name=GYG_Backend

spring.datasource.url=${DB_URL}
spring.datasource.username=${DB_USER}
spring.datasource.password=${DB_PASSWORD}
spring.mail.host=${SMTP_HOST:}
spring.mail.port=${SMTP_PORT:587}
spring.mail.username=${SMTP_USERNAME:}
spring.mail.password=${SMTP_PASSWORD:}
spring.mail.properties.mail.smtp.auth=${SMTP_AUTH:true}
spring.mail.properties.mail.smtp.starttls.enable=${SMTP_STARTTLS_ENABLE:true}
spring.mail.properties.mail.smtp.starttls.required=${SMTP_STARTTLS_REQUIRED:true}
spring.mail.properties.mail.smtp.connectiontimeout=${SMTP_CONNECTION_TIMEOUT_MS:5000}
spring.mail.properties.mail.smtp.timeout=${SMTP_TIMEOUT_MS:5000}
spring.mail.properties.mail.smtp.writetimeout=${SMTP_WRITE_TIMEOUT_MS:5000}
app.mail.from=${APP_MAIL_FROM:}
app.mail.test-connection=${APP_MAIL_TEST_CONNECTION:false}
spring.jpa.show-sql=false
app.cors.allowed-origins=${APP_CORS_ALLOWED_ORIGINS:}
app.captcha.enabled=${APP_CAPTCHA_ENABLED:true}
app.captcha.provider=${APP_CAPTCHA_PROVIDER:turnstile}
app.captcha.secret=${APP_CAPTCHA_SECRET:}
app.captcha.expected-hostnames=${APP_CAPTCHA_EXPECTED_HOSTNAMES:}
app.captcha.ticket-ttl-seconds=${APP_CAPTCHA_TICKET_TTL_SECONDS:120}
app.auth.admin-emails=${APP_ADMIN_EMAILS:}
app.swagger.public=${APP_SWAGGER_PUBLIC:false}
app.rate-limit.contacto-per-hour=${APP_RATE_LIMIT_CONTACTO_PER_HOUR:5}
app.rate-limit.newsletter-per-hour=${APP_RATE_LIMIT_NEWSLETTER_PER_HOUR:5}
app.rate-limit.chat-per-minute=${APP_RATE_LIMIT_CHAT_PER_MINUTE:20}
app.rate-limit.seguimiento-per-minute=${APP_RATE_LIMIT_SEGUIMIENTO_PER_MINUTE:10}
app.rate-limit.password-reset-per-hour=${APP_RATE_LIMIT_PASSWORD_RESET_PER_HOUR:5}
app.tracking-code.pepper=${APP_TRACKING_CODE_PEPPER:}
app.privacy.policy-version=${APP_PRIVACY_POLICY_VERSION:2026-01}
app.privacy.chat-retention-months=${APP_CHAT_LOG_RETENTION_MONTHS:12}
app.privacy.chat-retention-cron=${APP_CHAT_LOG_RETENTION_CRON:0 0 3 * * *}
app.http.max-body-size=${APP_MAX_REQUEST_BODY_SIZE:1MB}
spring.jackson.deserialization.fail-on-unknown-properties=true
spring.profiles.default=prod
server.forward-headers-strategy=native
server.tomcat.remoteip.internal-proxies=${APP_TRUSTED_PROXIES:(?!)}
server.tomcat.remoteip.remote-ip-header=${APP_REMOTE_IP_HEADER:X-Forwarded-For}
spring.jpa.hibernate.ddl-auto=validate
spring.flyway.enabled=true
spring.flyway.baseline-on-migrate=true
spring.flyway.baseline-version=1
app.cors.dev-origins=${APP_CORS_DEV_ORIGINS:http://localhost:*,http://127.0.0.1:*}

app.supabase.url=${SUPABASE_URL:}
app.supabase.publishable-key=${SUPABASE_PUBLISHABLE_KEY:}
